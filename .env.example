# Copy to .env. Never commit the real .env.
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
FOUNDRY_DEPLOYMENT=YOUR-DEPLOYMENT
FOUNDRY_API_KEY=
LLM_AUTH_MODE=api_key
# Only needed for a user-assigned managed identity.
AZURE_CLIENT_ID=
# managed_identity in Azure; azure_cli explicitly uses your local az login session.
LOGS_AUTH_MODE=managed_identity
LOG_ANALYTICS_WORKSPACE_ID=
FOUNDRY_RESOURCE_ID=
# Leave empty to use the built-in, verified rule: AzureDiagnostics CorrelationId == apim-request-id.
# Set only to test another field; a custom field stays a candidate until you confirm it.
LOG_ID_FIELD=
LOG_ID_MAPPING_VERIFIED=false
DATABASE_PATH=.data/experiments.sqlite3
